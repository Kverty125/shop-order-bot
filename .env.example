# Copy this file to .env and fill it in. NEVER commit .env!

# Bot token from @BotFather (required)
BOT_TOKEN=

# Password for /admin login. Send /admin to the bot and type it. Leave empty to disable.
ADMIN_PASSWORD=

# Or set admin Telegram IDs directly, comma-separated (find yours via @userinfobot)
ADMIN_IDS=

# Storefront
SHOP_NAME=Our Shop
# {amount} is replaced with the price, e.g. "{amount} EUR" or "${amount}"
PRICE_FORMAT=${amount}
# WELCOME_TEXT=Welcome to Our Shop! Browse the catalog and place an order.
# ABOUT_TEXT=Write something about your shop here.

# Storage: by default a local JSON file. For hosts with an ephemeral disk (Render, Heroku...)
# use MongoDB Atlas instead:
# MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB=shop_bot
# DATA_FILE=shop_data.json

# Tiny web server for hosts that need an open port (Render web service)
# ENABLE_WEB=1
# PORT=10000
